# UrbanEco Link Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection String with PostGIS enabled
# Format: postgresql://username:password@localhost:5432/urbaneco_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbaneco_db

# Security & Authentication
JWT_SECRET=urbaneco_super_secret_jwt_key_2026_swm_rules_prod
JWT_EXPIRES_IN=7d

# CORS & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
