# UrbanEco Link Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL connection string. Use the Supabase connection string for Codespaces.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbaneco_db
# Optional alias when DATABASE_URL is reserved for another environment.
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres?sslmode=require
DATABASE_SSL=false

# Security & Authentication
JWT_SECRET=urbaneco_super_secret_jwt_key_2026_swm_rules_prod
JWT_EXPIRES_IN=7d

# CORS & Rate Limiting
# Use a comma-separated list of trusted frontend origins.
# For GitHub Codespaces, keep localhost and any .app.github.dev origin enabled.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://*.app.github.dev
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
